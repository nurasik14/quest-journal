# Quest Journal configuration. Copy to `.env` and edit. Every key is optional.
# Full guide: README.md → "Choosing an AI provider" and "Configuration reference".

# ---------------------------------------------------------------- journal and server
# DATA_DIR=~/quest-data
# HOST=127.0.0.1
# PORT=4317
# TZ=Asia/Almaty
# DAY_ROLLOVER_HOUR=4
# ALLOWED_HOSTS=localhost,127.0.0.1
# GIT_ENABLED=true

# ---------------------------------------------------------------- AI: pick ONE block

# 1) Claude subscription through the `claude` CLI (default; no key, no per-call billing)
AI_PROVIDER=claude-cli
# AI_MODEL=sonnet

# 2) Claude API key (pay per token)
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-sonnet-5

# 3) Ollama, free and local (`ollama pull qwen3.5` first)
# AI_PROVIDER=ollama
# AI_MODEL=qwen3.5
# AI_BASE_URL=http://localhost:11434

# 4) Any OpenAI-compatible API. Google Gemini's free tier, for example:
# AI_PROVIDER=openai
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_API_KEY=your-key
# AI_MODEL=gemini-3.8-flash
#    Groq:       AI_BASE_URL=https://api.groq.com/openai/v1   AI_MODEL=openai/gpt-oss-20b
#    OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1     AI_MODEL=<a model id ending in :free>
#    LM Studio:  AI_BASE_URL=http://localhost:1234/v1         (no key)

# Advanced
# AI_ENABLED=true            # false = quests only from your pool (quests.yaml)
# AI_JSON_MODE=schema        # schema | json | off
# AI_TIMEOUT_MS=60000        # 180000 by default for ollama
# OLLAMA_NUM_CTX=16384
# DEBUG=1                    # keep recent raw AI replies at GET /api/debug/ai
